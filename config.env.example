# Copy to config.env and fill in values. Never commit config.env.

DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_MODERATOR_ROLE_ID=
OPENAI_API_KEY=

# Optional general
DEBUG_MODE=false
LOG_LEVEL=INFO
SS_DEBUG_START=false
MAX_QUEUE_SIZE=50
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW=60
# TTS_ROLE_ID=

# ---------------------------------------------------------------------------
# Quality control — narrow tuning (see /quality show in Discord)
# All settings have validated defaults; uncomment only what you want to change.
# ---------------------------------------------------------------------------

# --- TTS audio output ---
# TTS_MODEL=tts-1-hd          # tts-1-hd | tts-1
# TTS_SPEED=1.0               # 0.25–4.0
# TTS_AUDIO_VOLUME=0.7        # 0.0–2.0 playback volume
# TTS_DEFAULT_VOICE=alloy
# TTS_MP3_BYTES_PER_SECOND=16000

# --- TTS text pipeline ---
# TTS_CHUNK_SIZE=4000
# TTS_PRONUNCIATION_ENABLED=true
# TTS_PRONUNCIATION_MAX_CHARS=3500
# TTS_PRONUNCIATION_MODEL=gpt-3.5-turbo
# TTS_PRONUNCIATION_TEMPERATURE=0.1
# TTS_PRONUNCIATION_TIMEOUT=10
# TTS_PRONUNCIATION_CACHE_SIZE=200
# TTS_SENTENCE_BOUNDARY_MIN_PERCENT=0.8
# TTS_GRAMMAR_CORRECTIONS_ENABLED=true

# --- TTS API reliability ---
# TTS_API_TIMEOUT_BASE=60
# TTS_API_TIMEOUT_PER_100_CHARS=0.15
# TTS_API_TIMEOUT_MAX=180
# TTS_API_RETRY_MAX_ATTEMPTS=3
# TTS_API_RETRY_BASE_DELAY=1.0
# TTS_API_RETRY_MAX_DELAY=30.0
# TTS_MIN_VALID_AUDIO_SIZE=100
# TTS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# TTS_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
# TTS_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# --- TTS playback ---
# TTS_AUDIO_PLAYBACK_TIMEOUT_BASE=120
# TTS_AUDIO_PLAYBACK_TIMEOUT_MULTIPLIER=2.0
# TTS_AUDIO_PLAYBACK_TIMEOUT_BUFFER=30
# TTS_AUDIO_PLAYBACK_TIMEOUT_MAX=600
# TTS_AUDIO_PLAYBACK_START_DELAY=0.3
# TTS_DAVE_ENCRYPT_READY_TIMEOUT=20.0
# TTS_DAVE_ENCRYPT_READY_POLL=0.05
# TTS_VOICE_DISCONNECT_DELAY=3.0
# VOICE_TIMEOUT=10
# AUTO_DISCONNECT_TIMEOUT=300

# --- TTS cache & queue ---
# MAX_TTS_CACHE=50
# TTS_CACHE_TTL_AUDIO=3600
# TTS_CACHE_TTL_PRONUNCIATION=7200
# MESSAGE_EXPIRY_TIME=60
# GUILD_IDLE_TIMEOUT=600

# --- DALL-E ---
# DALLE_DEFAULT_QUALITY=hd          # standard | hd
# DALLE_DEFAULT_SIZE=1024x1024
# DALLE_DEFAULT_STYLE=vivid         # vivid | natural
# DALLE_MODEL=dall-e-3
# DALLE_CACHE_TTL=3600
# DALLE_MAX_RETRIES=3
# DALLE_REQUEST_TIMEOUT=45
# DALLE_JOB_EXPIRY_SECONDS=300

# --- Secret Santa anonymization ---
# SS_ANONYMIZE_MODEL=gpt-3.5-turbo
# SS_ANONYMIZE_TEMPERATURE=0.2
# SS_ANONYMIZE_MAX_TOKENS=150
# SS_ANONYMIZE_AGGRESSIVENESS=medium   # low | medium | high
# SS_ANONYMIZE_FAIL_CLOSED=false       # true = block message if anonymization fails

# Deploy (Docker / TrueNAS only)
# GIT_BRANCH=master
# GIT_UPDATE=true
