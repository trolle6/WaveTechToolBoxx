# Copy to config.env and fill in values. Never commit config.env.

DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
OPENAI_API_KEY=

# Optional — if unset/invalid, only guild admins + owner can run mod commands
# DISCORD_MODERATOR_ROLE_ID=

# Optional tuning
DEBUG_MODE=false
LOG_LEVEL=INFO
SS_DEBUG_START=false

# TTS / voice (optional)
# TTS_CHANNEL_NAME=no-mic-bot   # Only this text channel triggers TTS (default). Use "all" for every channel.
# TTS_CHANNEL_ID=               # Optional snowflake override (wins over name)
# TTS_ROLE_ID=
# OPENAI_VOICES=alloy,ash,coral,echo,fable,nova,onyx,sage,shimmer,ballad,verse,marin,cedar
# TTS_MODEL=gpt-4o-mini-tts     # tts-1-hd only supports the first nine voices
# PRONUNCIATION_MODEL=gpt-5.6-terra   # chat model for TTS gamertags + Secret Santa anonymizing
# TTS_URL=https://api.openai.com/v1/audio/speech   # only change if OpenAI moves the speech endpoint
# TTS_VOLUME=1.0                # after loudness normalization; 1.3 = louder, 0.8 = softer
# TTS_MAX_FILE_CHARS=20000      # attached .txt files are read aloud up to this many characters
# MAX_TTS_CACHE=50
# MAX_QUEUE_SIZE=50
# VOICE_TIMEOUT=30        # Do NOT use 10 — voice handshake needs more headroom
# AUTO_DISCONNECT_TIMEOUT=300

# Deploy (Docker / TrueNAS only) — TTS needs network_mode: host (see DEPLOYMENT.md)
# GIT_BRANCH=master
# GIT_UPDATE=true
