# Copy to config.env and fill in values. Never commit config.env.

DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_MODERATOR_ROLE_ID=
OPENAI_API_KEY=

# Optional tuning
DEBUG_MODE=false
LOG_LEVEL=INFO
SS_DEBUG_START=false

# TTS / voice (optional)
# TTS_ROLE_ID=
# MAX_TTS_CACHE=50
# MAX_QUEUE_SIZE=50
# VOICE_TIMEOUT=10
# AUTO_DISCONNECT_TIMEOUT=300

# Deploy (Docker / TrueNAS only)
# GIT_BRANCH=master
# GIT_UPDATE=true

# TTS dev lab (browser UI on port 8765 — optional; not the Discord bot)
# Requires start_tts_lab.py on the deployed branch (merge PR #15 or newer).
# TTS_LAB_ENABLED=false
# TTS_LAB_HOST=0.0.0.0
# TTS_LAB_PORT=8765
