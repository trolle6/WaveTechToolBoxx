# Copy to config.env and fill in values. Never commit config.env.

DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_MODERATOR_ROLE_ID=
OPENAI_API_KEY=

# Optional tuning
DEBUG_MODE=false
LOG_LEVEL=INFO
SS_DEBUG_START=false

# TTS / voice (optional)
# TTS_ROLE_ID=
# MAX_TTS_CACHE=50
# MAX_QUEUE_SIZE=50
# VOICE_TIMEOUT=10
# AUTO_DISCONNECT_TIMEOUT=300

# Deploy (Docker / TrueNAS only)
# GIT_BRANCH=master
# GIT_UPDATE=true
